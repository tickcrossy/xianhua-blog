// ---------------------------------------------------------------------------
// 设计变量
// 颜色一律走 CSS 自定义属性，深浅色只覆盖变量、不重写规则。
// ---------------------------------------------------------------------------

// 中英混排：英文优先用系统的「圆体」（macOS/iOS 的 ui-rounded / SF Pro Rounded），
// 显得更松弛友好；没有圆体的平台回落到常规 UI 字体。中文回落到平台自带黑体，
// PingFang 本身字形也偏柔和，整体气质统一，且全程不加载 webfont。
$sans = ui-rounded, 'SF Pro Rounded', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Source Han Sans SC', 'Noto Sans CJK SC', sans-serif;
$mono = ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', 'Courier New', monospace;

// 字号调大后栏宽要跟着收，否则一行的字数会变多、读起来更累。
// 39rem × 18px ≈ 700px，和之前 43rem × 17px 的行长基本一致。
$measure = 39rem;
// 首页 / 列表页用更宽的容器，容纳多栏网格；文章正文仍走窄栏 $measure。
$measure-wide = 66rem;
$gutter  = 1.5rem;

:root {
  // 白底为主，只留一丝暖意：底色是几乎察觉不到的暖白，
  // 强调色仍走温橙，整体比原来的奶油调更干净、更接近极简排版。
  --bg: #fdfcfa;
  --bg-soft: #f5f1ea;
  --bg-code: #f4efe7;
  --fg: #24211c;
  --fg-muted: #6b655b;
  --fg-faint: #9c958a;
  --border: #e9e3d8;
  --border-soft: #f0ebe2;
  --accent: #c2693c;
  --accent-hover: #a5502a;
  --mark: #fbe7bd;
  --selection: #f2e0c8;

  --easy: #5a8a4a;
  --easy-bg: #eaf1e2;
  --medium: #b07d28;
  --medium-bg: #f6ecd4;
  --hard: #b35540;
  --hard-bg: #f6e4dc;
  --plain: var(--fg-muted);
  --plain-bg: var(--bg-soft);

  // 列表页不再用厚卡片，阴影收到几乎不可见，靠留白和排版分隔。
  --card: var(--bg);
  --card-shadow: none;
  --card-shadow-hover: 0 6px 20px rgba(60, 45, 30, 0.07);
}

[data-scheme='dark'] {
  --bg: #1b1917;
  --bg-soft: #242019;
  --bg-code: #221e18;
  --fg: #e8e2d6;
  --fg-muted: #a49c8e;
  --fg-faint: #706860;
  --border: #342e26;
  --border-soft: #29241d;
  --accent: #e0955f;
  --accent-hover: #eeb27f;
  --mark: #4c3d1c;
  --selection: #3a3020;

  --easy: #8ec07c;
  --easy-bg: #202a1a;
  --medium: #d9ad63;
  --medium-bg: #2c2515;
  --hard: #e0917c;
  --hard-bg: #2e2019;

  --card: var(--bg);
  --card-shadow: none;
  --card-shadow-hover: 0 6px 20px rgba(0, 0, 0, 0.3);
}
