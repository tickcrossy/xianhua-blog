// ---------------------------------------------------------------------------
// 基础排版、页面骨架、页眉页脚
// ---------------------------------------------------------------------------

*, *::before, *::after { box-sizing: border-box; }

html {
  // 版面尺寸几乎都用 rem 写，所以放大字号要从根节点开始 ——
  // 只改 body 的话标题是 rem、正文是 px，两者比例会跑掉。
  // 注意媒体查询里的 rem 始终按 16px 算，不受这里影响，断点仍然稳定。
  font-size: 17px;
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
  scroll-padding-top: 2rem;
}

@media (min-width: 40rem) {
  html { font-size: 18px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: $sans;
  font-size: 1rem;
  line-height: 1.75;
  // 中英之间不自动加空格，但让浏览器用更好的断行策略
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::selection { background: var(--selection); }

a {
  color: var(--accent);
  text-decoration: none;
  transition: color 0.15s ease;
}
a:hover { color: var(--accent-hover); }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 2px;
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  padding: 0.5rem 1rem;
  background: var(--bg);
  border: 1px solid var(--border);
  z-index: 10;
}
.skip-link:focus { left: 0.5rem; top: 0.5rem; }

.wrap {
  max-width: $measure;
  margin: 0 auto;
  padding: 0 $gutter;
}

.main { min-height: 60vh; }

.empty {
  color: var(--fg-faint);
  padding: 3rem 0;
  text-align: center;
}

.scheme-toggle {
  appearance: none;
  background: none;
  border: 0;
  padding: 0;
  margin: 0;
  cursor: pointer;
  color: var(--fg-faint);
  line-height: 0;
  align-self: center;
  transition: color 0.15s ease;
}
.scheme-toggle:hover { color: var(--fg); }
.scheme-toggle svg {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
}
.scheme-toggle .i-moon { display: none; }
[data-scheme='dark'] .scheme-toggle .i-sun { display: none; }
[data-scheme='dark'] .scheme-toggle .i-moon { display: inline; }

// --- 正文容器 ---------------------------------------------------------------
// 头部在上方居中，正文单栏在下方铺开，中间留一段呼吸空间。

.site-body {
  padding-top: 2.5rem;
}

// --- 页脚 ------------------------------------------------------------------

.site-footer {
  margin-top: 5rem;
  padding: 2rem 0 3.5rem;
  border-top: 1px solid var(--border-soft);
  font-size: 0.85rem;
  color: var(--fg-faint);
  text-align: center;
}
.site-footer p { margin: 0.4rem 0; }
.site-footer a { color: var(--fg-muted); }
.site-footer a:hover { color: var(--accent); }

.footer-social {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  justify-content: center;
}

.site-footer .sep { padding: 0 0.15rem; }

// --- 难度 / 普通标签 --------------------------------------------------------

.tag {
  display: inline-block;
  vertical-align: 0.12em;
  font-size: 0.68rem;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0.03em;
  padding: 0.12rem 0.55rem;
  border-radius: 999px;
  white-space: nowrap;
  background: var(--plain-bg);
  color: var(--plain);
}
a.tag:hover { filter: brightness(0.96); }
[data-scheme='dark'] a.tag:hover { filter: brightness(1.25); }

.tag--easy   { background: var(--easy-bg);   color: var(--easy); }
.tag--medium { background: var(--medium-bg); color: var(--medium); }
.tag--hard   { background: var(--hard-bg);   color: var(--hard); }

// --- 分页 ------------------------------------------------------------------

.paginator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-top: 4rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border-soft);
  font-size: 0.9rem;
}
.paginator a,
.paginator .page-number,
.paginator .space {
  color: var(--fg-muted);
  padding: 0.15rem 0.2rem;
}
.paginator a:hover { color: var(--accent); }
.paginator .page-number.current {
  color: var(--fg);
  font-weight: 600;
}
