// ---------------------------------------------------------------------------
// 首页文章流、归档、标签列表
// ---------------------------------------------------------------------------

// 每篇文章是一张暖色圆角卡片，卡片之间留空隙，鼠标移上去轻轻抬起。
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.entry {
  position: relative;
  padding: 1.25rem 1.4rem;
  background: var(--card);
  border: 1px solid var(--border-soft);
  border-radius: 16px;
  box-shadow: var(--card-shadow);
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}
// 让整张卡片都可点：标题链接的伪元素铺满卡片，点哪儿都进文章，
// 同时保留链接语义（无障碍、右键复制链接都正常）。
.entry { cursor: pointer; }
.entry-title a::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
}
.entry:hover {
  transform: translateY(-3px);
  box-shadow: var(--card-shadow-hover);
  border-color: var(--border);
}

// 置顶卡片：左侧一道暖色描边 + 淡淡的底色，一眼看出被按住了
.entry.is-pinned {
  background: var(--medium-bg);
  border-color: transparent;
  box-shadow: inset 3px 0 0 var(--accent), var(--card-shadow);
}
.entry.is-pinned:hover {
  box-shadow: inset 3px 0 0 var(--accent), var(--card-shadow-hover);
}
.entry-list--pinned { margin-bottom: 0.9rem; }

.entry-head {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.3rem;
}

.entry-date {
  font-family: $mono;
  font-size: 0.76rem;
  letter-spacing: 0.02em;
  color: var(--fg-faint);
  font-variant-numeric: tabular-nums;
}

.entry-pin {
  font-size: 0.68rem;
  color: var(--fg-faint);
  border: 1px solid var(--border);
  border-radius: 3px;
  padding: 0 0.3rem;
  line-height: 1.5;
}

.entry-title {
  margin: 0;
  font-size: 1.12rem;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: 0.01em;
}
.entry-title a { color: var(--fg); }
.entry-title a:hover { color: var(--accent); }
.entry-title .tag { margin-left: 0.45rem; }

.entry-excerpt {
  margin: 0.35rem 0 0;
  font-size: 0.92rem;
  line-height: 1.7;
  color: var(--fg-muted);
}

// --- 归档 / 标签页 ---------------------------------------------------------

.list-header {
  padding-bottom: 1.75rem;
  margin-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-soft);
}

.list-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.list-count {
  margin: 0.3rem 0 0;
  font-size: 0.85rem;
  color: var(--fg-faint);
}

.archive-year { margin-top: 2.5rem; }

.archive-year-label {
  margin: 0 0 0.75rem;
  font-family: $mono;
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--fg-faint);
}
.archive-year-label .tag { font-family: $sans; }

.tag-count {
  font-size: 0.72rem;
  color: var(--fg-faint);
  margin-left: 0.35rem;
}

.archive-list {
  list-style: none;
  margin: 0;
  padding: 0;
}

.archive-item {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding: 0.3rem 0;
  line-height: 1.6;
}
.archive-item time {
  flex: none;
  font-family: $mono;
  font-size: 0.76rem;
  color: var(--fg-faint);
  font-variant-numeric: tabular-nums;
}
.archive-item > a {
  color: var(--fg);
  font-size: 0.98rem;
}
.archive-item > a:hover { color: var(--accent); }
