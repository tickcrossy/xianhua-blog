// ---------------------------------------------------------------------------
// 侧边栏
// 宽屏：左侧固定一栏（头像 / 站名 / 导航 / 深浅色切换），正文让出左边距。
// 窄屏：整栏塌成页面顶部的一条，头像与站名同排，导航横向换行。
// ---------------------------------------------------------------------------

$sidebar = 15rem;

.site-sidebar {
  padding: 2.5rem $gutter 1.5rem;
}

.sidebar-inner {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
  height: 100%;
}

// --- 头像与站名 -------------------------------------------------------------

.site-avatar {
  display: block;
  width: 5.5rem;
  height: 5.5rem;
  margin-bottom: 0.9rem;
  border-radius: 50%;
  overflow: hidden;
  // 头像多半是照片，深浅色下都给一圈极轻的描边压住边缘
  box-shadow: 0 0 0 1px var(--border);
  transition: box-shadow 0.15s ease;
}
.site-avatar:hover { box-shadow: 0 0 0 1px var(--fg-faint); }
.site-avatar img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.site-title {
  display: block;
  font-size: 1.15rem;
  font-weight: 650;
  letter-spacing: 0.01em;
  line-height: 1.4;
  color: var(--fg);
}
.site-title:hover { color: var(--accent); }

.site-tagline {
  margin: 0.3rem 0 0;
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--fg-faint);
}

// --- 导航 ------------------------------------------------------------------

.site-nav {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  font-size: 0.9rem;
}

.site-nav a {
  display: block;
  padding: 0.3rem 0;
  color: var(--fg-muted);
}
.site-nav a:hover { color: var(--fg); }

// --- 底部（深浅色切换 + 社交链接）-------------------------------------------

.sidebar-foot {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: auto;
  padding-top: 1.5rem;
  font-size: 0.82rem;
}
.sidebar-social { color: var(--fg-faint); }
.sidebar-social:hover { color: var(--accent); }

// ---------------------------------------------------------------------------
// 宽屏：固定侧栏
// ---------------------------------------------------------------------------

@media (min-width: 64rem) {
  .site-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: $sidebar;
    padding: 3.5rem 1.75rem 2rem;
    // 一条发丝线把侧栏和正文分开，否则它在大屏上会孤零零飘在左边
    border-right: 1px solid var(--border-soft);
    // 侧栏比屏幕高时自己滚，不带着正文一起动
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .site-body {
    margin-left: $sidebar;
  }
}

// ---------------------------------------------------------------------------
// 窄屏：塌成顶部一条
// ---------------------------------------------------------------------------

@media (max-width: 63.99rem) {
  .site-sidebar {
    border-bottom: 1px solid var(--border-soft);
  }

  .sidebar-inner {
    max-width: $measure;
    margin: 0 auto;
    gap: 1.1rem;
  }

  .site-id {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .site-avatar {
    flex: none;
    width: 3.1rem;
    height: 3.1rem;
    margin-bottom: 0;
  }

  .site-title { font-size: 1.05rem; }

  .site-nav {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.35rem 1.15rem;
  }
  .site-nav a { padding: 0; }

  .sidebar-foot {
    margin-top: 0;
    padding-top: 0;
  }

  .site-body { padding-top: 2.5rem; }
}
