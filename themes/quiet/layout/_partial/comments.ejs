<%
  const c = theme.comments || {};
  // 单篇开关：front-matter 里写 comments: false 关掉本篇，comments: true 强制打开；
  // 不写时跟随主题配置 comments.default（缺省为开）。
  const on = page.comments === false ? false
           : page.comments === true ? true
           : c.default !== false;
  // 三个关键 id 齐了、且本篇未关闭，才渲染；缺任意一个当作没配置、整块不显示。
  const ready = on && c.repo && c.repo_id && c.category_id;
%>
<% if (ready) { %>
<section class="post-comments"
         aria-label="<%= __('comments') %>"
         data-giscus-light="<%= c.theme_light || 'light' %>"
         data-giscus-dark="<%= c.theme_dark || 'transparent_dark' %>">
  <h2 class="post-comments-title"><%= __('comments') %></h2>
  <script src="https://giscus.app/client.js"
          data-repo="<%= c.repo %>"
          data-repo-id="<%= c.repo_id %>"
          data-category="<%= c.category || 'Announcements' %>"
          data-category-id="<%= c.category_id %>"
          data-mapping="<%= c.mapping || 'pathname' %>"
          data-strict="0"
          data-reactions-enabled="<%= c.reactions === false ? '0' : '1' %>"
          data-emit-metadata="0"
          data-input-position="<%= c.input_position || 'bottom' %>"
          data-theme="preferred_color_scheme"
          data-lang="<%= c.lang || 'zh-CN' %>"
          data-loading="lazy"
          crossorigin="anonymous"
          async>
  </script>
</section>
<% } %>
