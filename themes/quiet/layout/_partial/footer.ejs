<footer class="site-footer">
  <div class="wrap">
    <% /* 社交链接放在顶部头部，版权行按需去掉，页脚只留一点点信息 */ %>
    <% if ((theme.footer || {}).powered) { %>
      <p class="footer-meta">Powered by <a href="https://hexo.io/" rel="noopener">Hexo</a></p>
    <% } %>
    <% if ((theme.footer || {}).custom) { %>
      <p class="footer-custom"><%- theme.footer.custom %></p>
    <% } %>
  </div>
</footer>
